		{
			"id": "MaterialExpressionCustom_000002368EFB5D00",
			"class": "Custom",
			"class_full": "MaterialExpressionCustom",
			"pos_x": -400,
			"pos_y": 0,
			"properties":
			{
				"Code": "\nfloat2 q=(floor(UV*float2(44,52))+.5)/float2(44,52);\nfloat t=floor(Time*10.0)/10.0+Phase*7.0;\nfloat h=q.y;\nfloat sway=sin(h*8.0-t*2.5)*.07*h+sin(h*19.0-t*3.3)*.024;\nfloat x=abs(q.x-.5-sway);\nfloat width=.34*pow(saturate(1.0-h),.75);\nfloat scallop=sin(h*27.0-t*4.1)*.027+sin(q.x*47.0+h*13.0+t*3.0)*.018;\nfloat mask=step(x,width+scallop)*step(.018,h)*step(h,.97);\nfloat core=saturate(1.0-x/max(width,.01))*saturate((.8-h)*1.8);\nfloat3 c=lerp(float3(1.65,.14,.008),float3(3.0,1.14,.10),floor(core*4.0)/4.0);\nreturn float4(c,mask);\n",
				"OutputType": "CMOT_Float4",
				"Description": "Cindehearth pixel Fire",
				"Inputs": "((InputName=\"UV\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/Cindehearth/HD2D_v002/Materials/M_CH_PixelFire.M_CH_PixelFire:MaterialExpressionTextureCoordinate_0'\")),(InputName=\"Time\",Input=(Expression=\"/Script/Engine.MaterialExpressionTime'/Game/Cindehearth/HD2D_v002/Materials/M_CH_PixelFire.M_CH_PixelFire:MaterialExpressionTime_0'\")),(InputName=\"Phase\",Input=(Expression=\"/Script/Engine.MaterialExpressionScalarParameter'/Game/Cindehearth/HD2D_v002/Materials/M_CH_PixelFire.M_CH_PixelFire:MaterialExpressionScalarParameter_0'\")))",
				"ContainsClipInstruction": "CMCI_Search",
				"ShowCode": "False"
			},
			"hlsl_code": "\nfloat2 q=(floor(UV*float2(44,52))+.5)/float2(44,52);\nfloat t=floor(Time*10.0)/10.0+Phase*7.0;\nfloat h=q.y;\nfloat sway=sin(h*8.0-t*2.5)*.07*h+sin(h*19.0-t*3.3)*.024;\nfloat x=abs(q.x-.5-sway);\nfloat width=.34*pow(saturate(1.0-h),.75);\nfloat scallop=sin(h*27.0-t*4.1)*.027+sin(q.x*47.0+h*13.0+t*3.0)*.018;\nfloat mask=step(x,width+scallop)*step(.018,h)*step(h,.97);\nfloat core=saturate(1.0-x/max(width,.01))*saturate((.8-h)*1.8);\nfloat3 c=lerp(float3(1.65,.14,.008),float3(3.0,1.14,.10),floor(core*4.0)/4.0);\nreturn float4(c,mask);\n",
			"output_type": "CMOT_Float4",
			"custom_input_names": "UV,Time,Phase",
