    {
      "id": "MaterialExpressionCustom_0000023615B76180",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": -450,
      "pos_y": 0,
      "properties": {
        "Code": "// Persistent, rooted fire with five independent tapered tongues.\nfloat2 q=(floor(UV*float2(64.0,80.0))+.5)/float2(64.0,80.0);\nfloat t=floor(Time*16.0)/16.0+Phase*9.0;\nfloat h=q.y;\nfloat field=-1.0;\nfloat heat=0.0;\n[unroll] for(int i=0;i<5;i++){\n    float seed=float(i)*2.371;\n    float peak=.55+.19*sin(seed+1.2)+.07*sin(t*2.1+seed);\n    float u=max(0.0,(h-.045)/peak);\n    float bend=(sin(u*7.0-t*2.6+seed)*.047+sin(u*15.0-t*3.7+seed)*.019)*u;\n    float center=.24+float(i)*.13+bend;\n    float width=(.115+.022*sin(seed))*pow(saturate(1.0-u),.82);\n    width*=.85+.15*sin(u*20.0-t*5.0+seed);\n    float density=(width-abs(q.x-center))/max(width,.012);\n    density=min(density,(1.0-u)*8.0);\n    field=max(field,density);\n    heat=max(heat,saturate(density)*saturate((.56-h)*2.6));\n}\nfloat root=smoothstep(.035,.065,h);\nfloat a=smoothstep(0.0,.16,field)*root;\nfloat bands=floor(saturate(heat)*6.0)/6.0;\nfloat3 orange=lerp(float3(1.4,.095,.003),float3(2.7,.62,.018),saturate(field*1.5));\nfloat3 col=lerp(orange,float3(3.9,2.25,.43),bands);\na*=lerp(.68,.96,saturate(field));\n// A few motes separate from the tip and fade out before their loop reset.\n[unroll] for(int j=0;j<3;j++){\n    float age=frac(t*(.19+.018*j)+float(j)*.317);\n    float2 pos=float2(.34+.16*j+.035*sin(age*5.0+j),.43+age*.51);\n    float2 delta=(q-pos)/float2(.011,.018);\n    float spark=saturate(1.0-dot(delta,delta))*smoothstep(.02,.16,age)*(1.0-smoothstep(.62,.98,age));\n    col=lerp(col,float3(2.8,1.14,.09),step(a,spark));\n    a=max(a,spark*.78);\n}\nreturn float4(col*Intensity,a);\n",
        "OutputType": "CMOT_Float4",
        "Description": "Cindehearth fixed front fire",
        "Inputs": "((InputName=\"UV\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/Cindehearth/Fire_v005/Materials/M_CH_FrontFire.M_CH_FrontFire:MaterialExpressionTextureCoordinate_0'\")),(InputName=\"Time\",Input=(Expression=\"/Script/Engine.MaterialExpressionTime'/Game/Cindehearth/Fire_v005/Materials/M_CH_FrontFire.M_CH_FrontFire:MaterialExpressionTime_0'\")),(InputName=\"Phase\",Input=(Expression=\"/Script/Engine.MaterialExpressionScalarParameter'/Game/Cindehearth/Fire_v005/Materials/M_CH_FrontFire.M_CH_FrontFire:MaterialExpressionScalarParameter_0'\")),(InputName=\"Intensity\",Input=(Expression=\"/Script/Engine.MaterialExpressionScalarParameter'/Game/Cindehearth/Fire_v005/Materials/M_CH_FrontFire.M_CH_FrontFire:MaterialExpressionScalarParameter_1'\")))",
        "ContainsClipInstruction": "CMCI_Search",
        "ShowCode": "False"
      },
      "hlsl_code": "// Persistent, rooted fire with five independent tapered tongues.\nfloat2 q=(floor(UV*float2(64.0,80.0))+.5)/float2(64.0,80.0);\nfloat t=floor(Time*16.0)/16.0+Phase*9.0;\nfloat h=q.y;\nfloat field=-1.0;\nfloat heat=0.0;\n[unroll] for(int i=0;i<5;i++){\n    float seed=float(i)*2.371;\n    float peak=.55+.19*sin(seed+1.2)+.07*sin(t*2.1+seed);\n    float u=max(0.0,(h-.045)/peak);\n    float bend=(sin(u*7.0-t*2.6+seed)*.047+sin(u*15.0-t*3.7+seed)*.019)*u;\n    float center=.24+float(i)*.13+bend;\n    float width=(.115+.022*sin(seed))*pow(saturate(1.0-u),.82);\n    width*=.85+.15*sin(u*20.0-t*5.0+seed);\n    float density=(width-abs(q.x-center))/max(width,.012);\n    density=min(density,(1.0-u)*8.0);\n    field=max(field,density);\n    heat=max(heat,saturate(density)*saturate((.56-h)*2.6));\n}\nfloat root=smoothstep(.035,.065,h);\nfloat a=smoothstep(0.0,.16,field)*root;\nfloat bands=floor(saturate(heat)*6.0)/6.0;\nfloat3 orange=lerp(float3(1.4,.095,.003),float3(2.7,.62,.018),saturate(field*1.5));\nfloat3 col=lerp(orange,float3(3.9,2.25,.43),bands);\na*=lerp(.68,.96,saturate(field));\n// A few motes separate from the tip and fade out before their loop reset.\n[unroll] for(int j=0;j<3;j++){\n    float age=frac(t*(.19+.018*j)+float(j)*.317);\n    float2 pos=float2(.34+.16*j+.035*sin(age*5.0+j),.43+age*.51);\n    float2 delta=(q-pos)/float2(.011,.018);\n    float spark=saturate(1.0-dot(delta,delta))*smoothstep(.02,.16,age)*(1.0-smoothstep(.62,.98,age));\n    col=lerp(col,float3(2.8,1.14,.09),step(a,spark));\n    a=max(a,spark*.78);\n}\nreturn float4(col*Intensity,a);\n",
      "output_type": "CMOT_Float4",
