    {
      "name": "blender_repair_mesh_copy",
      "title": null,
      "description": "ONE bounded repair on a new mesh copy: weld; delete exact inspected component or face IDs; fill exact simple closed loops; or fill cycles within exact inspected boundary networks. Face-count/diameter guards apply. Preserve source, material and existing UV loops. Planar-project cap UVs into adjacent material regions. No implicit selection, remeshing, or arbitrary code.",
      "inputSchema": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "blend_path": {
            "title": "Blend Path",
            "type": "string"
          },
          "object_name": {
            "title": "Object Name",
            "type": "string"
          },
          "expected_fingerprint": {
            "title": "Expected Fingerprint",
            "type": "string"
          },
          "output_object_name": {
            "title": "Output Object Name",
            "type": "string"
          },
          "output_blend": {
            "title": "Output Blend",
            "type": "string"
          },
          "operation": {
            "enum": [
              "weld",
              "delete_components",
              "delete_faces",
              "fill_loops",
              "fill_networks",
              "cap_polygon"
            ],
            "title": "Operation",
            "type": "string"
          },
          "selection_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Selection Ids",
            "type": "array"
          },
          "distance": {
            "default": 1e-05,
            "title": "Distance",
            "type": "number"
          },
          "max_faces": {
            "default": 100,
            "title": "Max Faces",
            "type": "integer"
          },
          "max_diameter": {
            "default": 0.5,
            "title": "Max Diameter",
            "type": "number"
          }
        },
        "required": [
          "job_id",
          "blend_path",
          "object_name",
          "expected_fingerprint",
          "output_object_name",
          "output_blend",
          "operation",
          "selection_ids"
        ],
