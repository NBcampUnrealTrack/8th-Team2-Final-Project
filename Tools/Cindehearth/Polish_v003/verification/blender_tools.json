    {
      "name": "blender_animation_import_fbx",
      "title": "Import Animation FBX Into Blender",
      "description": "Import an FBX from the configured exchange root into new Blender objects and actions. Existing objects/actions are never deleted or replaced. Returns the exact imported names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute or exchange-root-relative path. The bridge rejects paths outside the configured exchange_root."
          },
          "name_prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional prefix applied to newly imported actions and non-armature objects. Unreal root and armature identities are preserved."
          },
          "root_bone_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact Unreal Skeleton root name from the export manifest. Blender 5 FBX imports may absorb this node into the armature object; the bridge restores it as a keyed bone before editing."
          },
          "expected_bone_hierarchy": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "description": "Exact, case-sensitive Blender data-block name."
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "parent"
              ]
            },
            "description": "Exact name/parent signature from the Unreal export manifest. Import fails before editing when Blender changes the hierarchy."
          },
          "timing_contract": {
            "type": "object",
            "properties": {
              "contract": {
                "const": "revvy.unreal_anim_sequence_fbx_timing.v1"
              },
              "source_exporter": {
                "const": "unreal.AnimSequenceExporterFBX"
              },
              "frame_count_convention": {
                "const": "sample_intervals"
              },
              "terminal_boundary_policy": {
                "const": "trim_one_verified_duplicate"
              },
              "expected_frame_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "expected_duration_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "expected_frame_rate": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              }
            },
            "additionalProperties": false,
            "required": [
              "contract",
              "source_exporter",
              "frame_count_convention",
              "terminal_boundary_policy",
              "expected_frame_count",
              "expected_duration_seconds",
              "expected_frame_rate"
            ],
            "description": "Exact Unreal source count, duration, rate, and verified terminal duplicate policy from the export job manifest."
          }
        },
        "additionalProperties": false,
        "required": [
          "path"
        ]
      },
