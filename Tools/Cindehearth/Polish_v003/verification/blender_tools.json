    {
      "name": "blender_animation_adjust",
      "title": "Adjust Blender Animation Keys",
      "description": "Apply only typed transform, timing, or interpolation edits to exact animation F-curves. Defaults to copying the source action and assigning the copy, so the original remains intact. No Python or arbitrary code execution is exposed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "armature_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact, case-sensitive Blender data-block name."
          },
          "action_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact, case-sensitive Blender data-block name."
          },
          "action_slot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact, case-sensitive Blender data-block name."
          },
          "operations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "transform"
                    },
                    "target": {
                      "type": "string",
                      "enum": [
                        "object",
                        "bone"
                      ]
                    },
                    "bone_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "Required exact pose-bone name when target is bone."
                    },
                    "channel": {
                      "type": "string",
                      "enum": [
                        "translate",
                        "rotate_euler",
                        "rotate_quaternion",
                        "scale"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "add",
                        "multiply",
                        "set"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 4,
                      "description": "XYZ for translate/rotate_euler/scale; WXYZ channel values for rotate_quaternion, matched by F-curve array index."
                    },
                    "units": {
                      "type": "string",
                      "enum": [
                        "degrees",
                        "radians"
                      ],
                      "default": "radians",
                      "description": "Only valid for rotate_euler."
                    },
                    "frame_start": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frame_end": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "target",
                    "channel",
                    "mode",
                    "values"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "time"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 100,
                      "default": 1
                    },
                    "offset": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000,
                      "default": 0
                    },
                    "pivot": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000,
                      "default": 0
                    },
                    "frame_start": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frame_end": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "interpolation"
                    },
                    "value": {
                      "type": "string",
                      "enum": [
                        "CONSTANT",
                        "LINEAR",
                        "BEZIER"
                      ]
                    },
                    "frame_start": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frame_end": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "value"
                  ]
                }
              ]
            },
            "minItems": 1,
            "maxItems": 100
          },
          "create_copy": {
            "type": "boolean",
            "const": true,
            "default": true,
            "description": "Must remain true. Revvy edits a transactional copy and never modifies the imported source action."
          },
          "output_action_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional unused exact name for the copied action. Requires create_copy=true."
          }
        },
        "additionalProperties": false,
        "required": [
          "armature_name",
          "action_name",
          "operations"
        ]
      },
      "outputSchema": null,
      "icons": null,
      "annotations": {
        "title": null,
