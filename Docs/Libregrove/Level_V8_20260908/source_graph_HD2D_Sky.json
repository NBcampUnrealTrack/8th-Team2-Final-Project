  "expressions": [
    {
      "id": "MaterialExpressionCustom_0000025764D558C0",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": 0,
      "pos_y": 0,
      "properties": {
        "Code": "\nfloat3 d = normalize(Dir);\nfloat h = d.z;\n\n// pastel vertical gradient: warm horizon -> pale mid -> soft blue zenith\nfloat t1 = saturate(h / 0.26);\nfloat3 sky = lerp(HorizonCol, MidCol, pow(t1, 0.85));\nfloat t2 = saturate((h - 0.26) / 0.74);\nsky = lerp(sky, ZenithCol, pow(t2, 0.75));\n\nfloat u = atan2(d.y, d.x) * 0.15915494 + 0.5;\nfloat v = 0.5 - asin(clamp(d.z, -1.0, 1.0)) * 0.31830989;\n\nfloat below = saturate((v - 0.5002) / 0.030);\nfloat deep = saturate((v - 0.505) / 0.10);\nsky = lerp(sky, lerp(GroundCol * 1.9, GroundCol * 0.55, deep), below);\n\n// painted clouds first, so the horizon haze can wash them out with distance\nfloat2 p = d.xy / max(h, 0.11);\nfloat2 uv1 = p * Tune.y + float2(Tune.z * Time, Tune.z * Time * 0.32);\nfloat2 uv2 = p * (Tune.y * 1.9) + float2(-Tune.z * Time * 1.6, Tune.z * Time * 0.5);\nfloat c1 = Texture2DSample(SkyTex, SkyTexSampler, uv1).r;\nfloat c2 = Texture2DSample(SkyTex, SkyTexSampler, uv2).g;\nfloat fade = smoothstep(0.16, 0.78, h);\nfloat a1 = saturate((c1 - Tune.x) * 3.0) * fade * 0.85;\nfloat a2 = saturate((c2 - Tune.x * 1.2) * 2.4) * fade * 0.38;\n// clouds pick up warm light on the side facing the sun\nfloat sunSide = saturate(dot(normalize(float3(SunDir.xy, 0.0)), normalize(float3(d.xy, 0.0)))) * 0.5 + 0.5;\nfloat3 litCloud = lerp(CloudCol, CloudCol * SunCol * 1.25, sunSide * 0.55);\nfloat3 cloudShaded = lerp(CloudShadow, litCloud, saturate((c1 - Tune.x) * 2.2));\nsky = lerp(sky, cloudShaded, a1);\nsky = lerp(sky, litCloud, a2);\n\n// three ranges from one crest profile, each washed further into the haze\nfloat tFar  = Texture2DSample(SkyTex, SkyTexSampler, float2(u, 0.5)).b;\nfloat tMid  = Texture2DSample(SkyTex, SkyTexSampler, float2(u * 1.9 + 0.31, 0.5)).b;\nfloat tNear = Texture2DSample(SkyTex, SkyTexSampler, float2(u * 3.3 + 0.63, 0.5)).b;\nfloat cFar  = 0.4972 - tFar  * 0.0235;\nfloat cMid  = 0.4986 - tMid  * 0.0140;\nfloat cNear = 0.4996 - tNear * 0.0078;\nfloat aa = 0.0006;\nfloat3 hazeCol = lerp(HorizonCol, MidCol, 0.35);\nsky = lerp(sky, lerp(hazeCol, RidgeFar, 0.30), smoothstep(cFar - aa, cFar + aa, v));\nsky = lerp(sky, lerp(RidgeFar, RidgeNear, 0.45), smoothstep(cMid - aa, cMid + aa, v));\nsky = lerp(sky, RidgeNear, smoothstep(cNear - aa, cNear + aa, v));\n\n// milky aerial-perspective band hugging the skyline, applied over everything distant\nfloat haze = exp(-max(h, 0.0) * 42.0) * step(0.0, h);\nsky = lerp(sky, hazeCol, haze * 0.30);\n\n// sun\nfloat sd = saturate(dot(d, normalize(SunDir)));\nsky += SunCol * pow(sd, 90.0) * 1.2;\nsky += SunCol * pow(sd, 5.0) * 0.16;\nsky = lerp(sky, SunCol * 2.4, smoothstep(0.99930, 0.99968, sd));\n\nreturn sky;\n",
        "OutputType": "CMOT_Float3",
        "Description": "HD2D Sky",
        "Inputs": "((InputName=\"Dir\",Input=(Expression=\"/Script/Engine.MaterialExpressionMultiply'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionMultiply_0'\")),(InputName=\"Time\",Input=(Expression=\"/Script/Engine.MaterialExpressionTime'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionTime_0'\")),(InputName=\"SkyTex\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionTextureObjectParameter_0'\")),(InputName=\"HorizonCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_0'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"MidCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_1'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"ZenithCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_2'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"GroundCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_3'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"CloudCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_4'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"CloudShadow\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_5'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"RidgeFar\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_6'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"RidgeNear\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_7'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"SunDir\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_8'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"SunCol\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_9'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"Tune\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/Village/Materials/M_HD2D_Sky.M_HD2D_Sky:MaterialExpressionVectorParameter_10'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)))",
        "ContainsClipInstruction": "CMCI_Search",
