      "id": "MaterialExpressionCustom_000002585389A780",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": -400,
      "pos_y": 0,
      "properties": {
        "Code": "\nfloat2 q = float2(UV.x*3.0, UV.y*1.8-Time*.50);\nfloat a = Texture2DSample(NoiseTex,NoiseTexSampler,q).r;\nfloat b = Texture2DSample(NoiseTex,NoiseTexSampler,q*float2(2.8,.7)+float2(.17,-Time*.20)).r;\nfloat ribbons = pow(saturate(sin(UV.x*73.0 + a*1.4)*.5+.5),5.0);\nfloat edge = smoothstep(0.,.12,UV.x)*smoothstep(0.,.12,1.-UV.x);\nfloat value = saturate(a*.55 + b*.35+ribbons*.35);\nfloat3 color = lerp(float3(.075,.33,.40),float3(.65,.88,.94),value);\nreturn float4(color,edge*saturate(.48+value*.45));\n",
        "OutputType": "CMOT_Float4",
        "Description": "Custom",
        "Inputs": "((InputName=\"UV\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/Libregrove/Level_V8/Materials/M_LG8_Waterfall.M_LG8_Waterfall:MaterialExpressionTextureCoordinate_0'\")),(InputName=\"Time\",Input=(Expression=\"/Script/Engine.MaterialExpressionTime'/Game/Libregrove/Level_V8/Materials/M_LG8_Waterfall.M_LG8_Waterfall:MaterialExpressionTime_0'\")),(InputName=\"NoiseTex\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureObjectParameter'/Game/Libregrove/Level_V8/Materials/M_LG8_Waterfall.M_LG8_Waterfall:MaterialExpressionTextureObjectParameter_0'\")))",
        "ContainsClipInstruction": "CMCI_Search",
        "ShowCode": "False"
      },
      "hlsl_code": "\nfloat2 q = float2(UV.x*3.0, UV.y*1.8-Time*.50);\nfloat a = Texture2DSample(NoiseTex,NoiseTexSampler,q).r;\nfloat b = Texture2DSample(NoiseTex,NoiseTexSampler,q*float2(2.8,.7)+float2(.17,-Time*.20)).r;\nfloat ribbons = pow(saturate(sin(UV.x*73.0 + a*1.4)*.5+.5),5.0);\nfloat edge = smoothstep(0.,.12,UV.x)*smoothstep(0.,.12,1.-UV.x);\nfloat value = saturate(a*.55 + b*.35+ribbons*.35);\nfloat3 color = lerp(float3(.075,.33,.40),float3(.65,.88,.94),value);\nreturn float4(color,edge*saturate(.48+value*.45));\n",
      "output_type": "CMOT_Float4",
      "custom_input_names": "UV,Time,NoiseTex",
