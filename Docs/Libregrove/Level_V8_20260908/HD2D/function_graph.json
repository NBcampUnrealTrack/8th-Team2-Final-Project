    {
      "id": "MaterialExpressionCustom_00000257A8C43700",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": -150,
      "pos_y": 0,
      "properties": {
        "Code": "\nfloat peak=max(1.0,max(SourceColor.r,max(SourceColor.g,SourceColor.b)));\nfloat3 c=pow(saturate(SourceColor/peak),1.0/2.2);\nfloat lum=dot(c,float3(.2126,.7152,.0722));\nc=lerp(lum.xxx,c,max(0.,Saturation));\nc=saturate((c-.5)*max(.1,Contrast)+.5+ShadowLift);\nfloat levels=max(4.0,PaletteSteps);\nc=lerp(c,floor(c*levels+.5)/levels,saturate(PosterizeStrength));\nc=pow(saturate(c),2.2)*GlobalTint*peak;\nreturn lerp(SourceColor,c,saturate(Strength));\n",
        "OutputType": "CMOT_Float3",
        "Description": "Custom",
        "Inputs": "((InputName=\"SourceColor\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_0'\")),(InputName=\"Saturation\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_1'\")),(InputName=\"Contrast\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_2'\")),(InputName=\"PaletteSteps\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_3'\")),(InputName=\"PosterizeStrength\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_4'\")),(InputName=\"ShadowLift\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_5'\")),(InputName=\"GlobalTint\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_6'\")),(InputName=\"Strength\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Libregrove/Level_V8/HD2D/MF_LG8_HD2D_Color.MF_LG8_HD2D_Color:MaterialExpressionFunctionInput_7'\")))",
